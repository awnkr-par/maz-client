<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MazLauncher</AssemblyName>
    <RootNamespace>MazLauncher</RootNamespace>
    <ApplicationIcon>Assets\MazLauncher.ico</ApplicationIcon>
    <Version>0.6.78</Version>
    <AssemblyVersion>0.6.78.0</AssemblyVersion>
    <FileVersion>0.6.78.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <Resource Include="Assets\MazLauncher.ico" />
  </ItemGroup>

  <Target Name="GenerateMazLauncherIcon" BeforeTargets="PrepareResources">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\generate-icon.ps1&quot;" />
  </Target>
</Project>
