<Window x:Class="MazLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MazLauncher" Height="650" Width="920" MinHeight="590" MinWidth="820"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Icon="Assets/MazLauncher.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0F172A"/>
        <SolidColorBrush x:Key="Surface" Color="#1E293B"/>
        <SolidColorBrush x:Key="Surface2" Color="#263449"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#334155"/>
        <SolidColorBrush x:Key="InputBg" Color="#172033"/>
        <SolidColorBrush x:Key="InputBorder" Color="#475569"/>
        <SolidColorBrush x:Key="Border" Color="#334155"/>
        <SolidColorBrush x:Key="Accent" Color="#6366F1"/>
        <SolidColorBrush x:Key="AccentHover" Color="#818CF8"/>
        <SolidColorBrush x:Key="Text" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Muted" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Placeholder" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>

        <Style x:Key="MazButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource MazButton}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <Style x:Key="ThemeButton" TargetType="Button" BasedOn="{StaticResource MazButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        </Style>
        <Style x:Key="MazTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,9"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceHover}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MazTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="Transparent" ClipToBounds="False"><ItemsPresenter/></Border>
                            <Border Grid.Row="1" Margin="0,12,0,0" Background="Transparent" ClipToBounds="False"><ContentPresenter ContentSource="SelectedContent"/></Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="10,0"/><Setter Property="Background" Value="{DynamicResource InputBg}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource InputBg}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="6"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,5"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource InputBg}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/></Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="28" Background="{DynamicResource Bg}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" Background="{DynamicResource Accent}" CornerRadius="12" Margin="0,0,14,0"><TextBlock Text="M" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="MazLauncher" Foreground="{DynamicResource Text}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="SettingsMenuButton" Style="{StaticResource MazButton}" Content="☰" Width="44" Height="44" FontSize="22" Padding="0" ToolTip="Settings" Click="SettingsMenuButton_Click"/>
        </Grid>

        <TabControl Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource MazTabControl}" Foreground="{DynamicResource Text}">
            <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource MazTabItem}"/></TabControl.Resources>
            <TabItem Header="PLAY"><Grid Background="{DynamicResource Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="VanillaButton" Click="VanillaButton_Click" Style="{StaticResource MazButton}" Height="112" Padding="18"><StackPanel><TextBlock Text="VANILLA" Foreground="{DynamicResource Text}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="VanillaSelectedText" Text="Loading versions..." Foreground="{DynamicResource Muted}" Margin="0,7,0,0" HorizontalAlignment="Center"/><TextBlock Text="Uses selection from Installations" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                <Button Grid.Column="2" x:Name="MazButton" Click="MazButton_Click" Style="{StaticResource AccentButton}" Height="112" Padding="18"><StackPanel><TextBlock Text="MAZCLIENT" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="MazVersionText" Text="Loading versions..." Foreground="White" Margin="0,7,0,0" HorizontalAlignment="Center"/><TextBlock Text="Version-isolated mods + configs" Foreground="White" Opacity="0.9" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
            </Grid></TabItem>
            <TabItem Header="INSTALLATIONS"><Grid Background="{DynamicResource Surface}" Margin="18,12,18,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Vanilla installation" Foreground="{DynamicResource Text}" FontSize="17" FontWeight="SemiBold"/><Grid Grid.Row="1" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="136"/></Grid.ColumnDefinitions><ComboBox x:Name="VanillaVersionBox" SelectionChanged="VanillaVersionBox_SelectionChanged"/><Button Grid.Column="2" Style="{StaticResource MazButton}" x:Name="LaunchVanillaSelectedButton" Content="LAUNCH" Click="LaunchVanillaSelectedButton_Click"/></Grid>
                <TextBlock Grid.Row="3" Text="MazClient installation" Foreground="{DynamicResource Text}" FontSize="17" FontWeight="SemiBold"/>
                <Grid Grid.Row="4" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="136"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="MazMinecraftVersionBox" SelectionChanged="MazMinecraftVersionBox_SelectionChanged" ToolTip="Minecraft version for MazClient"/>
                    <ComboBox Grid.Column="2" x:Name="MazClientVersionBox" SelectionChanged="MazClientVersionBox_SelectionChanged" ToolTip="MazClient version"/>
                    <Button Grid.Column="4" Style="{StaticResource AccentButton}" x:Name="LaunchMazSelectedButton" Content="LAUNCH" Click="LaunchMazSelectedButton_Click"/>
                </Grid>
                <TextBlock Grid.Row="5" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Text="Choose Minecraft 26.2 or the separate 1.21.11 compatibility build. Each Minecraft version uses an isolated MazClient installation so mods and configs cannot collide."/>
            </Grid></TabItem>
            <TabItem Header="MODS"><Grid Background="{DynamicResource Surface}" Margin="18,12,18,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ComboBox Grid.Row="0" x:Name="ModsMazVersionBox" Margin="0,8,0,10" SelectionChanged="ModsMazVersionBox_SelectionChanged"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ModToggleList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource MazButton}" Content="{Binding State}" Tag="{Binding}" Width="100" Click="ModRowToggle_Click"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0"><Button Style="{StaticResource AccentButton}" Content="ADD JAR" Width="96" Margin="0,0,8,0" Click="AddModButton_Click"/><Button Style="{StaticResource MazButton}" Content="OPEN FOLDER" Width="116" Click="OpenModsFolderButton_Click"/></StackPanel>
            </Grid></TabItem>
            <TabItem Header="SKINS">
                <Grid Background="{DynamicResource Surface}" Margin="18,12,18,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="12" VerticalAlignment="Center" Height="260">
                        <Grid>
                            <Image x:Name="SkinPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <TextBlock x:Name="SkinPreviewPlaceholder" Text="IMPORT A SKIN PNG" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="SKINS" Foreground="{DynamicResource Text}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Import a Minecraft skin PNG and apply it directly to your signed-in account." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <TextBlock Text="PLAYER MODEL" Foreground="{DynamicResource Muted}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="SkinModelBox" Width="220" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="Classic (Steve)" Tag="classic"/>
                            <ComboBoxItem Content="Slim (Alex)" Tag="slim"/>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="ImportSkinButton" Style="{StaticResource MazButton}" Content="IMPORT PNG" Width="118" Margin="0,0,10,0" Click="ImportSkinButton_Click"/>
                            <Button x:Name="ApplySkinButton" Style="{StaticResource AccentButton}" Content="APPLY SKIN" Width="118" Click="ApplySkinButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="SkinStatusText" Text="No skin selected." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="ACCOUNTS">
                <Grid Background="{DynamicResource Surface}" Margin="18,12,18,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="3">
                        <TextBlock Text="Choose your MazLauncher account" Foreground="{DynamicResource Text}" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="Online accounts use Microsoft authentication. Local accounts need no sign-in and are for offline/local sessions." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" Grid.ColumnSpan="3" x:Name="AccountsList" Margin="0,14,0,14" SelectionChanged="AccountsList_SelectionChanged" DisplayMemberPath="DisplayName"/>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="LOCAL ACCOUNT" Foreground="{DynamicResource Muted}" FontWeight="Bold" Margin="0,0,0,7"/>
                        <TextBox x:Name="LocalAccountNameBox" Height="38" Padding="10,8" ToolTip="Choose a local Minecraft username"/>
                        <Button Style="{StaticResource AccentButton}" x:Name="CreateLocalAccountButton" Content="CREATE LOCAL ACCOUNT" Margin="0,9,0,0" Click="CreateLocalAccountButton_Click"/>
                        <Button Style="{StaticResource MazButton}" x:Name="DeleteLocalAccountButton" Content="DELETE SELECTED LOCAL ACCOUNT" Margin="0,8,0,0" IsEnabled="False" Click="DeleteLocalAccountButton_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="MICROSOFT ACCOUNT" Foreground="{DynamicResource Muted}" FontWeight="Bold" Margin="0,0,0,7"/>
                        <TextBlock Text="Add an account through Microsoft's official sign-in flow. Your account will appear in the list after authentication." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,9"/>
                        <Button Style="{StaticResource AccentButton}" x:Name="AccountsSignInButton" Content="ADD MICROSOFT ACCOUNT" Click="SignInButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="CHANGELOG"><Grid Background="{DynamicResource Surface}" Margin="18,12,18,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="MazClient Changelog" Foreground="{DynamicResource Text}" FontSize="20" FontWeight="Bold"/><TextBox Grid.Row="1" x:Name="ChangelogText" Margin="0,10,0,0" Padding="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="1" FontFamily="Consolas" FontSize="12" Text="Loading changelog..."/></Grid></TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="CheckUpdatesButton" Style="{StaticResource MazButton}" Content="CHECK FOR UPDATES" Width="164" HorizontalAlignment="Left" Click="CheckUpdatesButton_Click"/><Button Grid.Column="1" x:Name="ThemeToggleButton" Style="{StaticResource ThemeButton}" Content="☀ LIGHT" Width="104" Click="ThemeToggleButton_Click" ToolTip="Switch between Light and Dark launcher themes"/></Grid>
        <StackPanel Grid.Row="3" Margin="0,10,0,0"><ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" Value="0"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel>

        <Border x:Name="SettingsOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Panel.ZIndex="50">
            <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Settings" Foreground="{DynamicResource Text}" FontSize="28" FontWeight="Bold"/><TextBlock Text="Launcher, account and accessibility" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource MazButton}" Content="✕" Width="40" Height="40" Padding="0" Click="CloseSettingsButton_Click"/></Grid>
                <ScrollViewer Grid.Row="1" Margin="0,20,0,16" VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="ACCOUNT" Foreground="{DynamicResource Muted}" FontWeight="Bold"/><Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14" Margin="0,8,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="AccountText" Text="Not signed in" Foreground="{DynamicResource Text}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Microsoft / Xbox account" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="SignOutButton" Style="{StaticResource MazButton}" Content="SIGN OUT" Width="104" Margin="0,0,8,0" Click="SignOutButton_Click" Visibility="Collapsed"/><Button x:Name="SignInButton" Style="{StaticResource AccentButton}" Content="SIGN IN" Width="104" Click="SignInButton_Click"/></StackPanel></Grid></Border>
                    <TextBlock Text="LAUNCHER" Foreground="{DynamicResource Muted}" FontWeight="Bold"/><CheckBox x:Name="KeepLauncherOpenCheck" Content="Keep launcher open after Minecraft starts" Checked="SettingsChanged" Unchecked="SettingsChanged"/><CheckBox x:Name="CheckUpdatesOnStartupCheck" Content="Check for launcher updates on startup" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                    <TextBlock Text="ACCESSIBILITY" Foreground="{DynamicResource Muted}" FontWeight="Bold" Margin="0,16,0,4"/><CheckBox x:Name="HighContrastCheck" Content="High contrast" Checked="SettingsChanged" Unchecked="SettingsChanged"/><CheckBox x:Name="LargeTextCheck" Content="Larger launcher text" Checked="SettingsChanged" Unchecked="SettingsChanged"/><CheckBox x:Name="StrongFocusCheck" Content="Stronger keyboard focus indicators" Checked="SettingsChanged" Unchecked="SettingsChanged"/><CheckBox x:Name="ReducedMotionCheck" Content="Reduce motion and visual effects" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                    <TextBlock Text="MINECRAFT" Foreground="{DynamicResource Muted}" FontWeight="Bold" Margin="0,16,0,4"/><TextBlock Text="Java, RAM and per-installation folders are managed from Installations. More launch defaults will move here as profiles expand." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                </StackPanel></ScrollViewer>
                <TextBlock Grid.Row="2" Text="Settings save automatically." Foreground="{DynamicResource Muted}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
